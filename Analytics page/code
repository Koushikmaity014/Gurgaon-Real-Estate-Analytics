# Sector-wise Word Cloud
# ============================

st.header("Sector-wise Word Cloud")

selected_sector = st.selectbox(
    "Select Sector",["Overall"] + sorted(df["sector"].dropna().unique()),key="wc")

feature_text = pickle.load(open("dataset/feature_text.pkl", "rb"))

wc = WordCloud(width=800, height=400, background_color="white").generate(feature_text)

fig, ax = plt.subplots(figsize=(10,5))
ax.imshow(wc, interpolation="bilinear")
ax.axis("off")
st.pyplot(fig)

st.header("Area vs Price Analysis")
df1 = pd.read_csv("dataset/gurgaon_properties_missing_value_imputation.csv")

# Dropdown: All Properties, Flat, House
selected_type = st.selectbox("Select Property Type",["All Properties", "Flat", "House"], key="area_vs_price_property_type")

# Filter data
if selected_type == "Flat":
    filtered_df = df1[df1["property_type"] == "flat"].copy()

elif selected_type == "House":
    filtered_df = df1[df1["property_type"] == "house"].copy()

else:
    filtered_df = df1.copy()

# Create scatter plot
fig1 = px.scatter(filtered_df,x="built_up_area",y="price", color="bedRoom",title=f"Area Vs Price - {selected_type}")

# Show chart in Streamlit
st.plotly_chart(fig1, use_container_width=True)

st.header("BHK Pie Chart")
sector = st.selectbox("Select Sector", ["Overall"] + sorted(df1["sector"].dropna().unique()), key="bhk_sector")
pie_df = df1 if sector == "Overall" else df1[df1["sector"] == sector]
bhk_count = pie_df["bedRoom"].value_counts().reset_index()
bhk_count.columns = ["BHK", "Count"]
bhk_count["BHK"] = bhk_count["BHK"].astype(str) + " BHK"
fig2 = px.pie(bhk_count, names="BHK",values="Count",title=f"BHK Distribution - {sector}")
st.plotly_chart(fig2, use_container_width=True)

st.header("Side by side BHK price comparison")
fig3=px.box(df1[df1['bedRoom'] <= 4], x='bedRoom', y='price', title='BHK Price Range')
st.plotly_chart(fig3, use_container_width=True)

st.header("House vs Flat Price Distribution")

fig, ax = plt.subplots(figsize=(10, 5))

sns.kdeplot(data=df1,  x="price", hue="property_type", fill=True, ax=ax)

ax.set_xlabel("Price (Crores)")
ax.set_ylabel("Density")

st.pyplot(fig)
