import matplotlib.pyplot as plt
import streamlit as st
import pandas as pd
import numpy as np
import plotly.express as px
import seaborn as sns
from wordcloud import WordCloud
import pickle

st.set_page_config(page_title="Property Map", layout="wide")
st.title("Analytics")
st.header("Gurgaon Property Price Map")
# Load data
df = pd.read_csv("dataset/data_viz1.csv")
# Clean property type
df["property_type"] = df["property_type"].astype(str).str.strip().str.lower()
# Convert numeric columns
cols = ["price", "price_per_sqft", "built_up_area", "latitude", "longitude"]
for col in cols:
    df[col] = pd.to_numeric(df[col], errors="coerce")
# Dropdown
selected_type = st.selectbox("Select Property Type",["All Properties", "Flat", "House"])
# Filter data
if selected_type != "All Properties":
    df = df[df["property_type"] == selected_type.lower()].copy()
# Sector-wise average
plot_df = df.groupby("sector")[cols].mean().reset_index()
# Remove missing or invalid values
plot_df = plot_df.dropna()
plot_df = plot_df[(plot_df["built_up_area"] > 0) & (plot_df["price_per_sqft"] > 0)].copy()

# Make bubbles visible
max_area = plot_df["built_up_area"].quantile(0.95)

plot_df["bubble_size"] = np.sqrt(plot_df["built_up_area"].clip(lower=100, upper=max_area))

# Create map
fig = px.scatter_mapbox(plot_df,lat="latitude",lon="longitude", color="price_per_sqft", size="bubble_size", size_max=45,hover_name="sector", hover_data={"price": ":.2f","price_per_sqft": ":,.0f", "built_up_area": ":,.0f", "bubble_size": False },
    color_continuous_scale="Turbo",
    mapbox_style="open-street-map",
    zoom=10.8,
    center={
        "lat": plot_df["latitude"].mean(),
        "lon": plot_df["longitude"].mean()
    },
    height=800
)

# Bubble visibility
fig.update_traces(marker=dict(opacity=0.85))

# Layout
fig.update_layout(
    margin=dict(l=0, r=0, t=40, b=0),
    title=f"Gurgaon Sector-wise {selected_type} Price Map",
    coloraxis_colorbar=dict(
        title="Price per Sqft",
        x=0.98,
        y=0.5,
        len=0.75
    )
)

st.caption(f"Total sectors plotted: {len(plot_df)}")

st.plotly_chart(
    fig,
    width="stretch",
    config={
        "scrollZoom": True,
        "displaylogo": False
    }
)

